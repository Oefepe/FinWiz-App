{
  "expo": {
    "name": "FinWiz",
    "slug": "finwiz",
    "owner": "oefepe",
    "version": "0.1.0",
    "scheme": "finwiz",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.finwiz.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.finwiz.app",
      "permissions": [
        "android.permission.BIND_NOTIFICATION_LISTENER_SERVICE",
        "android.permission.INTERNET"
      ],
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff"
        }
      ],
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "FinWiz uses Face ID to unlock your financial data instead of a separate app password."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "d4ba7568-17be-4a31-8ec4-39109df64f18"
      }
    }
  }
}
