<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>WFWorkflowActions</key>
	<array>
		<!--
		  Open FinWiz with the banking notification encoded in the URL.
		  Set up a Personal Automation in Shortcuts (Notification from Bradesco)
		  and replace the four PLACEHOLDER values with magic variables:
		    NOTIFICATION_TITLE → Notification Title   (Automation trigger variable)
		    NOTIFICATION_BODY  → Notification Body    (Automation trigger variable)
		    UNIX_TIMESTAMP_MS  → Format Date (format: x) action output
		    HMAC_KEY           → Key shown in FinWiz Settings › Vault Connection
		-->
		<dict>
			<key>WFWorkflowActionIdentifier</key>
			<string>is.workflow.actions.openurl</string>
			<key>WFWorkflowActionParameters</key>
			<dict>
				<key>WFInput</key>
				<dict>
					<key>Value</key>
					<dict>
						<key>attachmentsByRange</key>
						<dict/>
						<key>string</key>
						<string>finwiz://ingest?bank=com.bradesco&amp;title=NOTIFICATION_TITLE&amp;body=NOTIFICATION_BODY&amp;ts=UNIX_TIMESTAMP_MS&amp;hmac=HMAC_KEY</string>
					</dict>
					<key>WFSerializationType</key>
					<string>WFTextTokenString</string>
				</dict>
				<key>Show-HideResult</key>
				<false/>
			</dict>
		</dict>
	</array>
	<key>WFWorkflowClientVersion</key>
	<string>1165</string>
	<key>WFWorkflowHasShortcutInputVariables</key>
	<true/>
	<key>WFWorkflowIcon</key>
	<dict>
		<key>WFWorkflowIconGlyphNumber</key>
		<integer>59506</integer>
		<key>WFWorkflowIconStartColor</key>
		<integer>463140863</integer>
	</dict>
	<key>WFWorkflowImportQuestions</key>
	<array/>
	<key>WFWorkflowInputContentItemClasses</key>
	<array/>
	<key>WFWorkflowMinimumClientVersion</key>
	<integer>900</integer>
	<key>WFWorkflowName</key>
	<string>FinWiz – Bradesco</string>
	<key>WFWorkflowOutputContentItemClasses</key>
	<array/>
	<key>WFWorkflowTypes</key>
	<array/>
</dict>
</plist>